# For running on your own computer (`npm run dev`). Online, set the same values in Vercel -> Settings -> Environment Variables.

# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only these emails may use the app (comma separated)
ALLOWED_EMAILS=

# Which try-on AI to use: gemini | fashn | replicate | demo
TRYON_PROVIDER=gemini

# Google AI Studio: https://aistudio.google.com/apikey  (try-ons + AI stylist)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TEXT_MODEL=gemini-flash-latest

# FASHN: https://app.fashn.ai/api
FASHN_API_KEY=

# Replicate: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
