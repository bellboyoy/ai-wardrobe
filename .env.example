# Copy this file to .env and fill in what you need. Leave a key blank if you don't use that service.

# Which try-on AI to use: gemini | fashn | replicate | demo
# (blank = the first one you have a key for, otherwise demo)
TRYON_PROVIDER=gemini

# Google AI Studio: https://aistudio.google.com/apikey  (try-ons + AI stylist)
GEMINI_API_KEY=
# Optional model overrides
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TEXT_MODEL=gemini-flash-latest

# FASHN (dedicated try-on, very faithful): https://app.fashn.ai/api
FASHN_API_KEY=

# Replicate (open-source IDM-VTON): https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

PORT=3000

# Optional: set a password to open the app from your phone on the same Wi-Fi.
# Leave blank to allow only this computer.
APP_PASSWORD=
